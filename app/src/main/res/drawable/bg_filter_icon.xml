<?xml version="1.0" encoding="utf-8"?>
<!-- Tło ikonki filtra typu: zaznaczona = primary z 10% opacity + primary ramka, odznaczona = divider ramka -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stan zaznaczony (selected=true) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A136DEC"/>
            <stroke android:width="1.5dp" android:color="@color/primary"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

    <!-- Stan domyślny (odznaczony) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1.5dp" android:color="@color/divider"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

</selector>