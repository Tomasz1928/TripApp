<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Trip"
    android:layout_width="@dimen/trip_card_width"
    android:layout_height="wrap_content"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/corner_radius_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_default">

        <!-- HEADER: Title + refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tripTitle"
                    style="@style/Text.Body.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body_large"
                    tools:text="Wakacje Chorwacja"/>

                <TextView
                    android:id="@+id/tripDate"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_hint"
                    android:layout_marginTop="2dp"
                    tools:text="12.08 — 18.08 · 4 osoby"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/refreshBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_refresh"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- HERO AMOUNT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tripTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_title_large"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="4 250,00 PLN"/>

            <TextView
                android:id="@+id/tripMyCost"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hint"
                android:layout_marginTop="2dp"
                tools:text="Mój koszt: 1 062,50 PLN"/>
        </LinearLayout>

        <!-- PIECHART + LEGEND in grey container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_icon_rounded"
            android:padding="@dimen/padding_medium"
            android:layout_marginTop="@dimen/spacing_medium">

            <!-- PieChart -->
            <com.example.tripapp2.ui.common.widget.PieChartView
                android:id="@+id/pieChart"
                android:layout_width="64dp"
                android:layout_height="64dp"/>

            <!-- Legend ScrollView -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/legendContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_small"/>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_medium"
            android:baselineAligned="false"/>

        <!-- Buttons -->
        <Button
            android:id="@+id/detailsBtn"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trip_card_details_button"
            android:layout_marginTop="@dimen/spacing_small"/>

        <Button
            android:id="@+id/costDetailsBtn"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trip_card_view_costs_button"
            android:layout_marginTop="@dimen/spacing_small"/>

        <Button
            android:id="@+id/addCostBtn"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trip_card_add_cost_button"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_small"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
