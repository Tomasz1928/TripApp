<?xml version="1.0" encoding="utf-8"?>
<!--
    Split Expense Body — treść modala podziału kosztów.
    Wydzielona z fragment_split_expense_modal.xml (usunięto CardView + header + separator).
    Używana przez SplitExpenseModalFragment.onCreateBodyView().
    Używa TYLKO istniejących stringów i stylów.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Całkowity koszt -->
    <TextView
        android:id="@+id/totalExpenseLabel"
        style="@style/Text.Body.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Całkowity koszt: 0.00 PLN"
        android:gravity="center"
        android:textColor="@color/primary"/>

    <!-- Przycisk: rozdziel po równo -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/equalSplitButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="Podziel po równo"
        android:textSize="@dimen/text_size_small"/>

    <!-- Label: Kto uczestniczy? -->
    <TextView
        style="@style/Text.Body.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/split_participants_label"
        android:layout_marginTop="@dimen/spacing_medium"/>

    <!-- Lista uczestników (scroll po >5) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="@dimen/spacing_small">

        <LinearLayout
            android:id="@+id/participantsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- Suma podziału -->
    <TextView
        android:id="@+id/totalLabel"
        style="@style/Text.Body.Large"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suma: 0.00"
        android:layout_marginTop="@dimen/spacing_small"
        android:gravity="end"/>

    <!-- Komunikat o różnicy (ukryty gdy OK) -->
    <TextView
        android:id="@+id/differenceLabel"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:gravity="end"
        android:textColor="@color/error"
        android:visibility="gone"/>

    <!-- Przycisk zapisu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:text="@string/split_save_button"/>

</LinearLayout>