<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- TOP BAR: Koszty + Dodaj -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/padding_default"
        android:paddingVertical="@dimen/padding_default"
        android:background="@color/surface"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/costsTitle"
            style="@style/Text.Body.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_costs"
            android:textSize="@dimen/text_size_body_large"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addExpenseButton"
            style="@style/Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_topbar"
            android:text="@string/trip_costs_add_expense"
            android:textSize="@dimen/text_size_small"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/padding_default"
            app:cornerRadius="@dimen/corner_radius_small"
            app:icon="@drawable/ic_add"
            app:iconSize="14dp"
            app:iconGravity="textStart"
            app:iconPadding="4dp"/>
    </LinearLayout>

    <!-- FILTER CHIPS -->
    <HorizontalScrollView
        android:id="@+id/filtersScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/surface"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/filtersContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/padding_default"
            android:paddingVertical="@dimen/padding_small">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterAll"
                style="@style/Button.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_costs_filter_all"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterMine"
                style="@style/Button.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_costs_filter_mine"
                android:layout_marginStart="@dimen/spacing_tiny"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterPaidByMe"
                style="@style/Button.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_costs_filter_paid_by_me"
                android:layout_marginStart="@dimen/spacing_tiny"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterPaidByOthers"
                style="@style/Button.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_costs_filter_paid_by_others"
                android:layout_marginStart="@dimen/spacing_tiny"/>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:id="@+id/filtersDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/filtersScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- EXPENSES LIST -->
    <ScrollView
        android:id="@+id/scrollExpensesContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/filtersDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_default"
            android:paddingTop="@dimen/padding_default"
            android:paddingBottom="@dimen/bottom_nav_padding">

            <!-- Expense items grouped in one card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:id="@+id/expensesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@drawable/divider_horizontal"
                    android:showDividers="middle"/>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
