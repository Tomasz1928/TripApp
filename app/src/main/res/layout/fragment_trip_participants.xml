<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/padding_default"
        android:paddingVertical="@dimen/padding_medium"
        android:background="@color/surface"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/participantsTitle"
            style="@style/Text.Body.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_participants"
            android:textSize="@dimen/text_size_body_large"/>

        <!-- Manage button - only for owner -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/manageButton"
            style="@style/Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_topbar"
            android:text="Zarządzaj"
            android:textSize="@dimen/text_size_small"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/padding_default"
            android:visibility="gone"
            app:cornerRadius="@dimen/corner_radius_small"/>
    </LinearLayout>

    <!-- AVATAR STACK SUMMARY -->
    <LinearLayout
        android:id="@+id/summaryBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/padding_default"
        android:paddingVertical="@dimen/padding_medium"
        android:background="@color/surface"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/avatarStackContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>

        <TextView
            android:id="@+id/participantCount"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:textColor="@color/text_secondary"
            tools:text="4 uczestników"/>
    </LinearLayout>

    <!-- ACTIONS SCROLL (owner only) -->
    <HorizontalScrollView
        android:id="@+id/actionsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/surface"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/summaryBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/padding_default"
            android:paddingVertical="@dimen/padding_small">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionAll"
                style="@style/Button.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/participants_action_all"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionAdd"
                style="@style/Button.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/participants_action_add"
                android:layout_marginStart="@dimen/spacing_tiny"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionDetach"
                style="@style/Button.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/participants_action_detach"
                android:layout_marginStart="@dimen/spacing_tiny"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionDelete"
                style="@style/Button.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/participants_action_delete"
                android:layout_marginStart="@dimen/spacing_tiny"/>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:id="@+id/actionsDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/actionsScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PARTICIPANTS LIST -->
    <ScrollView
        android:id="@+id/scrollParticipants"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/actionsDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:id="@+id/participantsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@drawable/divider_horizontal"
                    android:showDividers="middle"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyState"
                style="@style/EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    android:id="@+id/emptyStateTitle"
                    style="@style/Text.Body.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_costs_no_expenses"/>

                <TextView
                    android:id="@+id/emptyStateMessage"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
