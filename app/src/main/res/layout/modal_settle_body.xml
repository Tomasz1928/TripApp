<?xml version="1.0" encoding="utf-8"?>
<!--
    Settle Body v2 — Propozycja C
    Zmiany:
    - TabLayout z delikatniejszym indicatorem
    - Separatory 0.5dp
    - Confirm buttons z corner_radius_small
    - Wszystkie ID ZACHOWANE — Kotlin BEZ ZMIAN
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- TAB LAYOUT -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/text_hint"
        app:tabRippleColor="@color/ripple">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settle_tab_by_value"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settle_tab_by_costs"/>
    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider"/>

    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="250dp">

        <!-- TAB 1: Per wartość -->
        <ScrollView
            android:id="@+id/tabByValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_default">

                <!-- Label -->
                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settle_select_currency"
                    android:textColor="@color/text_hint"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <!-- Currency cards ScrollView -->
                <ScrollView
                    android:id="@+id/currencyScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <RadioGroup
                        android:id="@+id/currencyRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Main currency card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/mainCurrencyCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_small"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="@dimen/corner_radius_medium"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/primary"
                            app:strokeWidth="1.5dp"
                            app:cardBackgroundColor="@color/surface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="@dimen/padding_tiny">

                                <RadioButton
                                    android:id="@+id/mainCurrencyRadio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:buttonTint="@color/primary"
                                    android:clickable="false"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/mainCurrencyLabel"
                                        style="@style/Text.Body.Bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:id="@+id/mainCurrencyAmount"
                                        style="@style/Text.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/text_secondary"/>
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/mainCurrencyDirectionIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:scaleType="fitCenter"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Container for other currencies (dynamically added) -->
                        <LinearLayout
                            android:id="@+id/otherCurrenciesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>

                    </RadioGroup>
                </ScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="@dimen/spacing_small"/>

                <!-- Amount label -->
                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settle_amount_label"
                    android:textColor="@color/text_hint"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <!-- Amount Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/amountInputLayout"
                    style="@style/InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settle_amount_hint"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_fill_max"
                    app:endIconContentDescription="@string/settle_fill_max"
                    app:endIconTint="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/amountInput"
                        style="@style/InputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settleButton"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/settle_confirm_button"
                    app:cornerRadius="@dimen/corner_radius_small"/>

            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: Per koszty -->
        <LinearLayout
            android:id="@+id/tabByCosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/costsScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/costsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/padding_small"
                    android:paddingTop="@dimen/padding_small"/>
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="@dimen/padding_default"/>

            <!-- Summary card -->
            <LinearLayout
                android:id="@+id/costsSummaryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_default">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/summaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/corner_radius_medium"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settle_by_costs_summary_label"
                            android:textColor="@color/text_hint"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"/>

                        <LinearLayout
                            android:id="@+id/summaryAmountsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="@dimen/spacing_tiny"/>

                        <TextView
                            android:id="@+id/costsEmptySelection"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settle_by_costs_empty_selection"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="@dimen/spacing_tiny"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settleByCostsButton"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/settle_confirm_button"
                    app:cornerRadius="@dimen/corner_radius_small"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
