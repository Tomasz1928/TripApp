<?xml version="1.0" encoding="utf-8"?>
<!--
    Settle Body — treść modala rozliczenia.
    Wydzielona z modal_settle.xml (usunięto CardView + header + separator).
    Zawiera: TabLayout + 2 zakładki (Per wartość, Per koszty)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- TAB LAYOUT -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settle_tab_by_value"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settle_tab_by_costs"/>
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="250dp">

        <!-- ================================== -->
        <!-- TAB 1: Per wartość -->
        <!-- ================================== -->
        <ScrollView
            android:id="@+id/tabByValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_default">

                <!-- Label: Wybierz walutę -->
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settle_select_currency"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <!-- Scrollowalny kontener walut -->
                <ScrollView
                    android:id="@+id/currencyScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="vertical">

                    <RadioGroup
                        android:id="@+id/currencyRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Główna waluta -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/mainCurrencyCard"
                            style="@style/Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_tiny"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginTop="@dimen/spacing_tiny"
                            android:layout_marginHorizontal="@dimen/spacing_small"
                            android:foreground="?attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="@dimen/padding_tiny"
                                android:paddingHorizontal="@dimen/padding_small"
                                android:gravity="center_vertical">

                                <RadioButton
                                    android:id="@+id/mainCurrencyRadio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"/>

                                <TextView
                                    android:id="@+id/mainCurrencyAmount"
                                    style="@style/Text.Body.Bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_small"/>

                                <TextView
                                    android:id="@+id/mainCurrencyLabel"
                                    style="@style/Text.Body"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="@dimen/spacing_tiny"/>

                                <ImageView
                                    android:id="@+id/mainCurrencyDirectionIcon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_arrow_downward"/>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Inne waluty (dynamicznie dodawane) -->
                        <LinearLayout
                            android:id="@+id/otherCurrenciesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>

                    </RadioGroup>
                </ScrollView>

                <!-- Separator -->
                <View
                    style="@style/Divider"
                    android:layout_marginVertical="@dimen/spacing_medium"/>

                <!-- Pole kwoty -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/amountInputLayout"
                    style="@style/InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settle_amount_hint"
                    app:errorEnabled="true"
                    app:suffixText="PLN"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_fill_max"
                    app:endIconContentDescription="@string/settle_fill_max"
                    app:endIconTint="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/amountInput"
                        style="@style/InputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Przycisk Rozlicz -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settleButton"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/settle_confirm_button"/>

            </LinearLayout>
        </ScrollView>

        <!-- ================================== -->
        <!-- TAB 2: Per koszty -->
        <!-- ================================== -->
        <LinearLayout
            android:id="@+id/tabByCosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/costsScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/costsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/padding_small"
                    android:paddingTop="@dimen/padding_small"/>
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="@dimen/padding_default"/>

            <LinearLayout
                android:id="@+id/costsSummaryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_default">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settle_by_costs_summary_label"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/summaryCard"
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/summaryAmountsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_small"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/costsEmptySelection"
                    style="@style/Text.Body.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settle_by_costs_empty_selection"
                    android:gravity="center"
                    android:paddingVertical="@dimen/spacing_medium"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settleByCostsButton"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/settle_confirm_button"
                    android:enabled="false"/>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>