<?xml version="1.0" encoding="utf-8"?>
<!--
    Item Settlement History Entry — Expandable
    Główna linia: [ikona 24dp] [kwota kolorowa] [data + godzina] [chevron opcjonalny]
    Rozszerzenie (opcjonalne): uczestnik, kwota trip, powiązane koszty
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/historyEntryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/padding_small"
    android:paddingHorizontal="@dimen/padding_tiny"
    android:background="?attr/selectableItemBackground">

    <!-- ======================================== -->
    <!-- GŁÓWNA LINIA: ikona + kwota + data + chevron -->
    <!-- ======================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Ikona typu rozliczenia (24dp) -->
        <ImageView
            android:id="@+id/historyEntryIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/settlement_details_status_icon"/>

        <!-- Kwota (kolorowa, rozciąga się) -->
        <TextView
            android:id="@+id/historyEntryAmount"
            style="@style/Text.Body.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_small"/>

        <!-- Data + godzina (prawa strona) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="@dimen/spacing_tiny">

            <TextView
                android:id="@+id/historyEntryDate"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/historyEntryTime"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <!-- Chevron (ukryty gdy brak expandable content) -->
        <ImageView
            android:id="@+id/historyEntryChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_down"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/modal_close"/>

    </LinearLayout>

    <!-- ======================================== -->
    <!-- ROZSZERZENIE (domyślnie ukryte) -->
    <!-- ======================================== -->
    <LinearLayout
        android:id="@+id/historyEntryExpandable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingTop="@dimen/spacing_tiny"
        android:visibility="gone">

        <!-- Uczestnik (ukryty gdy automatyczne) -->
        <LinearLayout
            android:id="@+id/historyEntryActorRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/settlement_history_label_participant"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/historyEntryActorValue"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <!-- Kwota w walucie tripu (ukryta gdy ta sama waluta) -->
        <LinearLayout
            android:id="@+id/historyEntryTripAmountRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/settlement_history_label_trip_amount"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/historyEntryTripAmountValue"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <!-- Powiązane koszty (ukryte gdy brak) -->
        <LinearLayout
            android:id="@+id/historyEntryExpensesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/settlement_history_label_expenses"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/historyEntryExpensesValue"
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>