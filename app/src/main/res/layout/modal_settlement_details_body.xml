<?xml version="1.0" encoding="utf-8"?>
<!--
    Settlement Details Body v2 — Propozycja C
    Zmiany:
    - TabLayout indicator 2dp, ripple color
    - Separatory 0.5dp zamiast 1dp
    - Labels z textColor hint + uppercase + letterSpacing
    - Wszystkie ID ZACHOWANE — Kotlin BEZ ZMIAN
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- TAB LAYOUT — same ikonki -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicatorColor="@color/primary"
        app:tabIndicatorHeight="2dp"
        app:tabIconTint="@color/tab_icon_selector"
        app:tabInlineLabel="true"
        app:tabRippleColor="@color/ripple">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_summary"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_costs"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_prepayment"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_history"/>
    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider"/>

    <!-- CONTENT CONTAINER -->
    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="200dp">

        <!-- TAB 1: Podsumowanie -->
        <ScrollView
            android:id="@+id/tabSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_default">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_all_related"
                    android:textColor="@color/text_hint"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"/>

                <LinearLayout
                    android:id="@+id/allRelatedContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_small"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="@dimen/spacing_medium"/>

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_left_for_settled"
                    android:textColor="@color/text_hint"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"/>

                <LinearLayout
                    android:id="@+id/leftForSettledContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_small"/>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: Koszty -->
        <LinearLayout
            android:id="@+id/tabCosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_default"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/costsScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/costsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <TextView
                android:id="@+id/costsEmptyState"
                style="@style/Text.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settlement_details_no_costs"
                android:gravity="center"
                android:padding="@dimen/padding_large"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- TAB 3: Zaliczki -->
        <ScrollView
            android:id="@+id/tabPrepayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_default">

                <TextView
                    android:id="@+id/prepaymentAmountLeftLabel"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_prepayment_amount_left"
                    android:textColor="@color/text_hint"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"/>

                <LinearLayout
                    android:id="@+id/prepaymentAmountLeftContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_small"/>

                <View
                    android:id="@+id/prepaymentSeparator"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="@dimen/spacing_medium"/>

                <TextView
                    android:id="@+id/prepaymentHistoryLabel"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_prepayment_history"
                    android:textColor="@color/text_hint"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"/>

                <LinearLayout
                    android:id="@+id/prepaymentHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_small"/>

                <TextView
                    android:id="@+id/prepaymentEmptyState"
                    style="@style/Text.Body.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_no_prepayments"
                    android:gravity="center"
                    android:padding="@dimen/padding_large"
                    android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 4: Historia rozliczeń -->
        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/filter_settlement_history"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_default">

                    <LinearLayout
                        android:id="@+id/historyListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <TextView
                        android:id="@+id/historyEmptyState"
                        style="@style/Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settlement_details_no_history"
                        android:gravity="center"
                        android:padding="@dimen/padding_large"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/historyFilteredEmptyState"
                        style="@style/Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settlement_history_no_results"
                        android:gravity="center"
                        android:padding="@dimen/padding_large"
                        android:visibility="gone"/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
