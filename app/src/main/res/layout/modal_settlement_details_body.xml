<?xml version="1.0" encoding="utf-8"?>
<!--
    Settlement Details Body — ZMIENIONY
    4 taby z samymi ikonkami (bez tekstu):
    Tab 1: Ogólne (ic_tab_summary)
    Tab 2: Wydatki (ic_tab_costs)
    Tab 3: Zaliczki (ic_tab_prepayment)
    Tab 4: Historia (ic_tab_history) — na razie pusty
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- TAB LAYOUT — same ikonki, bez tekstu -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicatorColor="@color/primary"
        app:tabIconTint="@color/tab_icon_selector"
        app:tabInlineLabel="true">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_summary"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_costs"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_prepayment"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_history"/>

    </com.google.android.material.tabs.TabLayout>

    <!-- CONTENT CONTAINER -->
    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="200dp">

        <!-- TAB 1: Podsumowanie -->
        <ScrollView
            android:id="@+id/tabSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_default">

                <!-- Sekcja: Relacja wszystkich kosztów -->
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_all_related"/>

                <LinearLayout
                    android:id="@+id/allRelatedContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_tiny"/>

                <!-- Separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="@dimen/spacing_small"/>

                <!-- Sekcja: Pozostało do rozliczenia -->
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_left_for_settled"/>

                <LinearLayout
                    android:id="@+id/leftForSettledContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_tiny"/>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: Koszty -->
        <LinearLayout
            android:id="@+id/tabCosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_default"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/costsScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/costsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <TextView
                android:id="@+id/costsEmptyState"
                style="@style/Text.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settlement_details_no_costs"
                android:gravity="center"
                android:padding="@dimen/padding_large"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- TAB 3: Zaliczki -->
        <ScrollView
            android:id="@+id/tabPrepayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_default">

                <!-- Pozostało z zaliczek -->
                <TextView
                    android:id="@+id/prepaymentAmountLeftLabel"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_prepayment_amount_left"/>

                <LinearLayout
                    android:id="@+id/prepaymentAmountLeftContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_tiny"/>

                <!-- Separator -->
                <View
                    android:id="@+id/prepaymentSeparator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="@dimen/spacing_small"/>

                <!-- Historia zaliczek -->
                <TextView
                    android:id="@+id/prepaymentHistoryLabel"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_prepayment_history"/>

                <LinearLayout
                    android:id="@+id/prepaymentHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_tiny"/>

                <!-- Empty state -->
                <TextView
                    android:id="@+id/prepaymentEmptyState"
                    style="@style/Text.Body.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settlement_details_no_prepayments"
                    android:gravity="center"
                    android:padding="@dimen/padding_large"
                    android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 4: Historia rozliczeń — na razie pusty -->
        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Filter bar (include) -->
            <include layout="@layout/filter_settlement_history"/>

            <!-- ScrollView z listą wpisów -->
            <ScrollView
                android:id="@+id/historyScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_default">

                    <!-- Kontener na wpisy historii -->
                    <LinearLayout
                        android:id="@+id/historyListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:showDividers="middle"
                        android:divider="?android:attr/listDivider"/>

                    <!-- Empty state -->
                    <TextView
                        android:id="@+id/historyEmptyState"
                        style="@style/Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settlement_details_no_history"
                        android:gravity="center"
                        android:padding="@dimen/padding_large"
                        android:visibility="gone"/>

                    <!-- Filtered empty state (gdy filtry wyczyszczą wszystko) -->
                    <TextView
                        android:id="@+id/historyFilteredEmptyState"
                        style="@style/Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settlement_history_no_results"
                        android:gravity="center"
                        android:padding="@dimen/padding_large"
                        android:visibility="gone"/>

                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </FrameLayout>
</LinearLayout>