<?xml version="1.0" encoding="utf-8"?>
<!--
    Item Settlement Detail Cost — ZMIENIONY
    Wiersz kosztu w tab "Koszty": tytuł + kwota z walutą + kontener ikon rozliczenia
    Zamiast pojedynczego ✓/✗ → duża ikona dominująca (24dp) + małe ikony secondary (16dp)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/padding_small"
    android:paddingHorizontal="@dimen/padding_tiny">

    <!-- Tytuł kosztu (lewa strona, rozciąga się) -->
    <TextView
        android:id="@+id/costTitle"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"/>

    <!-- Kwota z walutą -->
    <TextView
        android:id="@+id/costAmount"
        style="@style/Text.Body.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_small"/>

    <!-- Kontener ikon rozliczenia: duża (24dp) + małe (16dp) w rzędzie -->
    <LinearLayout
        android:id="@+id/settlementIconsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Ikona dominująca (główny typ rozliczenia) -->
        <ImageView
            android:id="@+id/settlementMainIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/settlement_details_status_icon"/>

        <!-- Kontener na małe ikony secondary (dynamicznie dodawane w kodzie) -->
        <LinearLayout
            android:id="@+id/settlementSecondaryIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

</LinearLayout>