<?xml version="1.0" encoding="utf-8"?>
<!--
    Item Settlement Detail Cost — ZMIENIONY (dual-currency)
    Wiersz kosztu w tab "Koszty":
    [tytuł] [kwoty: primary + secondary] [ikony rozliczenia]

    Logika wyświetlania:
    - Single-currency: costAmount (niebieskie) = waluta tripu, costAmountSecondary = GONE
    - Multi-currency: costAmount (niebieskie) = waluta kosztu, costAmountSecondary (pomarańczowe) = waluta tripu
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/padding_small"
    android:paddingHorizontal="@dimen/padding_tiny">

    <!-- Tytuł kosztu (lewa strona, rozciąga się) -->
    <TextView
        android:id="@+id/costTitle"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Hotel Berlin"/>

    <!-- Kwoty (vertical: primary + optional secondary) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginEnd="@dimen/spacing_small">

        <!-- Kwota główna (primary, always visible) -->
        <TextView
            android:id="@+id/costAmount"
            style="@style/Text.Body.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="225,00 EUR"/>

        <!-- Kwota drugorzędna (secondary, visible only when multi-currency) -->
        <TextView
            android:id="@+id/costAmountSecondary"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/secondary"
            android:layout_marginTop="1dp"
            android:visibility="gone"
            tools:text="950,00 PLN"/>
    </LinearLayout>

    <!-- Kontener ikon rozliczenia: duża (24dp) + małe (16dp) w rzędzie -->
    <LinearLayout
        android:id="@+id/settlementIconsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Ikona dominująca (główny typ rozliczenia) -->
        <ImageView
            android:id="@+id/settlementMainIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/settlement_details_status_icon"/>

        <!-- Kontener na małe ikony secondary (dynamicznie dodawane w kodzie) -->
        <LinearLayout
            android:id="@+id/settlementSecondaryIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

</LinearLayout>