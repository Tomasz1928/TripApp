<?xml version="1.0" encoding="utf-8"?>
<!--
    Prepayment Body — wydzielona treść z modal_prepayment.xml
    (usunięto CardView + header + separator — te są teraz w BaseModalFragment)
    Owrapowane w ScrollView bo formularz może być długi.

    ZMIANA vs oryginał:
    - currencyInputLayout: style InputLayout + endIconMode="dropdown_menu"
    - currencyDropdown: style InputEditText.Dropdown + inputType="text" (dla autocomplete)
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Uczestnik i balans -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/settlements_prepayment_participant"/>

            <TextView
                android:id="@+id/participantNickname"
                style="@style/Text.Body.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Aktualny balans -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_tiny">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/settlements_prepayment_current_balance"/>

            <TextView
                android:id="@+id/currentBalance"
                style="@style/Text.Body.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/divider"
            android:layout_marginVertical="@dimen/spacing_medium"/>

        <!-- Kierunek: Do mnie -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/directionToMeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/padding_small"
                android:gravity="center_vertical">

                <RadioButton
                    android:id="@+id/directionToMeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/primary"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="@string/settlements_prepayment_to_me"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_small">

                    <TextView
                        style="@style/Text.Body.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settlements_prepayment_to_me"/>

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settlements_prepayment_to_me_desc"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_downward"
                    app:tint="@color/success"
                    android:contentDescription="@string/settlements_prepayment_to_me"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Kierunek: Ode mnie -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/directionFromMeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/padding_small"
                android:gravity="center_vertical">

                <RadioButton
                    android:id="@+id/directionFromMeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/primary"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="@string/settlements_prepayment_from_me"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_small">

                    <TextView
                        style="@style/Text.Body.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settlements_prepayment_from_me"/>

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settlements_prepayment_from_me_desc"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_upward"
                    app:tint="@color/error"
                    android:contentDescription="@string/settlements_prepayment_from_me"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Input kwoty i waluty -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_medium">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/amountInputLayout"
                style="@style/InputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:layout_marginEnd="@dimen/spacing_small"
                android:hint="@string/settlements_prepayment_amount_hint"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/amountInput"
                    style="@style/InputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ZMIANA: style InputLayout + endIconMode + InputEditText.Dropdown + inputType="text" -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/currencyInputLayout"
                style="@style/InputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:hint="@string/settlements_prepayment_currency_hint"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/currencyDropdown"
                    style="@style/InputEditText.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Przycisk potwierdzenia -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settlements_prepayment_confirm"
            android:layout_marginTop="@dimen/spacing_small"/>

    </LinearLayout>
</ScrollView>