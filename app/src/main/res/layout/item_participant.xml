<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium"
    android:background="?attr/selectableItemBackground">

    <!-- Main row: Avatar + name/badge + expenses -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar circle -->
        <TextView
            android:id="@+id/participantAvatar"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:gravity="center"
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_avatar_circle_primary"
            tools:text="MK"/>

        <!-- Name + badge + expenses -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_medium">

            <!-- Name + badge row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/participantNickname"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="Marek"/>

                <!-- Owner Badge (pill) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ownerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:visibility="gone"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFF6FF">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="@string/participants_owner_badge"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="9sp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Active Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/activeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:visibility="gone"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#ECFDF5">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="@string/participants_active_badge"
                        android:textColor="@color/success"
                        android:textStyle="bold"
                        android:textSize="9sp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Placeholder Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/placeholderBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:visibility="gone"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F3F4F6">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="@string/participants_placeholder_badge"
                        android:textColor="@color/category_other"
                        android:textStyle="bold"
                        android:textSize="9sp"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Expenses -->
            <TextView
                android:id="@+id/participantExpenses"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="1dp"
                tools:text="Wydatki: 1 200,00 PLN"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Access Code Section (only for placeholders) -->
    <LinearLayout
        android:id="@+id/accessCodeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginStart="44dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/accessCodeText"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            tools:text="PLCH-0001"/>

        <ImageView
            android:id="@+id/copyCodeButton"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_trip_code"
            android:contentDescription="@string/participants_copy_code"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- Action Buttons (only for owner in DETACH/DELETE mode) -->
    <LinearLayout
        android:id="@+id/actionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginStart="44dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detachButton"
            style="@style/Button.Action.Warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Odłącz"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteButton"
            style="@style/Button.Action.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuń"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>
