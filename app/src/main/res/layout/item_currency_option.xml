<?xml version="1.0" encoding="utf-8"?>
<!--
    Item Currency Option (kompaktowa wersja)
    Karta z RadioButton dla wyboru waluty w modalu rozliczenia
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/currencyCard"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_tiny"
    app:strokeWidth="2dp"
    app:strokeColor="@color/divider"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/padding_tiny"
        android:paddingHorizontal="@dimen/padding_small"
        android:gravity="center_vertical">

        <RadioButton
            android:id="@+id/currencyRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_small">

            <TextView
                android:id="@+id/currencyLabel"
                style="@style/Text.Body.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="EUR"/>

            <TextView
                android:id="@+id/currencyAmount"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="Do rozliczenia: 50,00 EUR"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>