<?xml version="1.0" encoding="utf-8"?>
<!--
    Item Share Expenses — ZMIENIONY
    Wiersz podziału wydatku: osoba + ikony rozliczenia + kwoty
    Zamiast pojedynczego ✓/✗ → duża ikona (24dp) + małe secondary (16dp)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_tiny"
    android:gravity="center_vertical">

    <!-- LEWY KONTENER 40% -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5">

            <TextView
                android:id="@+id/sharePerson"
                style="@style/Text.Body.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="Anna"/>
        </FrameLayout>

        <!-- ZMIENIONE: kontener ikon breakdown zamiast pojedynczego ImageView -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Ikona dominująca (24dp) -->
                <ImageView
                    android:id="@+id/costShareSettlementMainIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/settlement_details_status_icon"/>

                <!-- Kontener na małe ikony secondary (16dp, dynamicznie dodawane) -->
                <LinearLayout
                    android:id="@+id/costShareSettlementSecondaryIcons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="2dp"/>

            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/shareAmountSecondary"
                style="@style/Text.Caption"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="12,45 EUR"
                android:textColor="@color/secondary"
                android:visibility="gone"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/shareAmountMain"
                style="@style/Text.Body.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="123,56 PLN"
                android:textColor="@color/primary"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>