<?xml version="1.0" encoding="utf-8"?>
<!--
    Trip Settlements Fragment Layout (NOWY)
    Struktura: Obrazek (25%) → Nagłówek → Podsumowanie balansu → Lista uczestników z balansami
    Wzorowany na fragment_trip_participants - używa TYLKO istniejących styli
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ================================== -->
        <!-- HEADER IMAGE - 25% wysokości ekranu -->
        <!-- ================================== -->
        <FrameLayout
            android:id="@+id/headerImageContainer"
            style="@style/HeaderImageContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.25">

            <ImageView
                android:id="@+id/headerImage"
                style="@style/HeaderImage"
                android:src="@drawable/header_l_settlements"/>

            <!-- Back Button (na obrazku) -->
            <ImageView
                android:id="@+id/backButton"
                style="@style/BackButton" />
        </FrameLayout>

        <!-- ================================== -->
        <!-- NAGŁÓWEK WIDOKU (WYŚRODKOWANY) -->
        <!-- ================================== -->
        <TextView
            android:id="@+id/settlementsTitle"
            style="@style/Text.Heading.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settlements_title"
            android:gravity="center"
            android:textAlignment="center"
            app:layout_constraintTop_toBottomOf="@id/headerImageContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ================================== -->
        <!-- KARTA PODSUMOWANIA MOJEGO BALANSU -->
        <!-- ================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/balanceSummaryCard"
            style="@style/Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_default"
            android:layout_marginTop="@dimen/spacing_small"
            app:layout_constraintTop_toBottomOf="@id/settlementsTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium"
                android:gravity="center">

                <TextView
                    android:id="@+id/balanceLabel"
                    style="@style/Text.Body.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settlements_my_balance"/>

                <TextView
                    android:id="@+id/balanceAmount"
                    style="@style/Text.Title.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0,00 PLN"
                    android:textColor="@color/success"
                    android:layout_marginTop="@dimen/spacing_tiny"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================================== -->
        <!-- TREŚĆ - Lista uczestników z balansami -->
        <!-- ================================== -->
        <ScrollView
            android:id="@+id/scrollParticipants"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/balanceSummaryCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/participantsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_default"/>
        </ScrollView>

        <!-- ================================== -->
        <!-- EMPTY STATE - Brak uczestników -->
        <!-- ================================== -->
        <LinearLayout
            android:id="@+id/emptyState"
            style="@style/EmptyState"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/balanceSummaryCard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_category_other_fees"
                app:tint="@color/text_hint"/>

            <TextView
                android:id="@+id/emptyStateTitle"
                style="@style/Text.Title.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settlements_empty_title"
                android:layout_marginTop="@dimen/spacing_medium"/>

            <TextView
                android:id="@+id/emptyStateMessage"
                style="@style/Text.Body.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settlements_empty_message"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_small"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
