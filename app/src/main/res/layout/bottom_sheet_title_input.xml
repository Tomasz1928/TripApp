<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_default">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_default"
        android:background="@drawable/bg_bottom_sheet_handle"/>

    <TextView
        style="@style/Text.Body.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tytuł i opis"
        android:textSize="@dimen/text_size_title"
        android:layout_marginBottom="@dimen/spacing_default"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sheetTitleLayout"
        style="@style/InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/add_expense_title_hint"
        app:counterEnabled="true"
        app:counterMaxLength="40">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sheetTitleInput"
            style="@style/InputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="40"
            android:inputType="textCapSentences"
            android:imeOptions="actionNext"
            android:singleLine="true"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/sheetTitleCounter"
        style="@style/Text.Counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/padding_medium"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:text="0/40"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sheetDescriptionLayout"
        style="@style/InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:hint="@string/add_expense_description_hint"
        app:counterEnabled="true"
        app:counterMaxLength="200">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sheetDescriptionInput"
            style="@style/InputEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height_multiline"
            android:maxLength="200"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/sheetDescriptionCounter"
        style="@style/Text.Counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/padding_medium"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:text="0/200"/>

    <Button
        android:id="@+id/sheetConfirmButton"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="Gotowe"/>

</LinearLayout>
