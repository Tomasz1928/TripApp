<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <!-- Top row: Avatar + Nickname + Balance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_small">

            <!-- Avatar -->
            <TextView
                android:id="@+id/participantAvatar"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:gravity="center"
                android:textSize="@dimen/text_size_tiny"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar_circle_primary"
                tools:text="AK"/>

            <!-- Nickname + balance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/participantNickname"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="Anna"/>

                <TextView
                    android:id="@+id/balanceAmount"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginTop="1dp"
                    tools:text="+125,00 PLN"
                    tools:textColor="@color/success"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons row (pill style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Zaliczka -->

            <!-- Szczegóły -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/prepaymentButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_topbar"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/spacing_tiny"
                android:text="@string/settlements_prepayment_button"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textAllCaps="false"
                android:fontFamily="@font/plus_jakarta_sans"
                app:backgroundTint="@color/background"
                app:rippleColor="@color/ripple"
                app:cornerRadius="@dimen/corner_radius_small"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settlementDetailsButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_topbar"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/spacing_tiny"
                android:text="@string/settlements_settlements_details_button"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textAllCaps="false"
                android:fontFamily="@font/plus_jakarta_sans"
                android:visibility="gone"
                app:backgroundTint="@color/background"
                app:rippleColor="@color/ripple"
                app:cornerRadius="@dimen/corner_radius_small"/>

            <!-- Rozlicz -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settleButton"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_topbar"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_tiny"
                android:text="@string/settlements_settle_button"
                android:textSize="@dimen/text_size_caption"
                android:visibility="gone"
                app:cornerRadius="@dimen/corner_radius_small"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
